# Copy to hermes-ops/.env and fill in. Loaded automatically by
# `hermes-ops` and `hermes-ops-auth`. Real environment variables override these.
# .env is gitignored — it holds the encryption key.

OPS_DATA_DIR=./.local/data
OPS_CONFIG_DIR=./.local/config

# from `uv run hermes-ops-auth keygen` — keep this; the same value must be set
# wherever the token file is read (your machine now, the Pi later)
OPS_ENCRYPTION_KEY=

# path to the Desktop-app OAuth client JSON downloaded from Google Cloud Console
OPS_CLIENT_SECRET=./secrets/client_secret.json

# optional: defaults to $OPS_CONFIG_DIR/policy.yaml
# OPS_POLICY_PATH=./.local/config/policy.yaml
